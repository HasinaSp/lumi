// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  passwordHash String?
  role         Role     @default(CLIENT)

  auditRequests AuditRequest[]
  payments Payment[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Payment {
  id String @id @default(cuid())

  provider String @default("lemonsqueezy")
  providerOrderId String @unique

  amount Int
  currency String
  status String

  offer AuditOffer

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurantName String?
  city String?
  platform Platform?
  marketplaceUrl String?
  message String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditReport {
  id        String   @id @default(cuid())

  auditId   String   @unique
  audit     AuditRequest @relation(fields: [auditId], references: [id], onDelete: Cascade)

  scoreGlobal     Int      @default(0)

  summary         String?

  strengths       String?
  improvements    String?
  recommendations String?

  photosScore     Int @default(0)
  menuScore       Int @default(0)
  pricingScore    Int @default(0)
  seoScore        Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditRequest {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurantName String
  city           String?
  platform       Platform
  offer          AuditOffer
  status         AuditStatus @default(PENDING)
  report         AuditReport?

  marketplaceUrl String?
  message        String?
  reportUrl      String?
  htmlReport     String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isArchived Boolean @default(false)
  archivedAt     DateTime?
}

enum Role {
  ADMIN
  CLIENT
}

enum Platform {
  UBEREATS
  DELIVEROO
  BOTH
}

enum AuditOffer {
  SIMPLE
  COMPLETE
  MONTHLY
}

enum AuditStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}
